# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── PostgreSQL (use Neon URL in production) ───────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── LLM — Groq in production (free & fast) ───────────────────────────────────
# Get key at: https://console.groq.com
LLM_MODEL=groq/llama3-8b-8192
GROQ_API_KEY=gsk_...

# ── Local Ollama (dev only) ───────────────────────────────────────────────────
# LLM_MODEL=ollama/qwen3:8b
# OLLAMA_API_BASE=http://localhost:11434

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://thecaffienate.com,https://www.thecaffienate.com
