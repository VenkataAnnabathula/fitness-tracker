# Copy to .env.local — Next.js loads this automatically.
# NEXT_PUBLIC_ prefix makes the variable available in the browser.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-REPLACE_WITH_YOUR_PUBLISHER_ID
NEXT_PUBLIC_ADSENSE_TOP_SLOT=REPLACE_WITH_TOP_AD_UNIT_ID
NEXT_PUBLIC_ADSENSE_BOTTOM_SLOT=REPLACE_WITH_BOTTOM_AD_UNIT_ID
ADSENSE_PUBLISHER_ID=REPLACE_WITH_NUMERIC_PUBLISHER_ID

# Enable only after the PDF editor repository is public.
NEXT_PUBLIC_SOURCE_URL=
